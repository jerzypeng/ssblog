root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{js,ts,vue,json,yml,yaml,md}]
indent_size = 2

[*.{styl,css,scss}]
indent_size = 2

[*.sh]
indent_style = tab
indent_size = 4

[*.bat]
indent_style = space
indent_size = 2
end_of_line = crlf

[Makefile]
indent_style = tab
indent_size = 4